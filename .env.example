# MongoDB configuration
MONGO_URL=mongodb://127.0.0.1:27017/
MONGO_DB_NAME=creditrisk_ai

# JWT configuration
JWT_SECRET=replace-with-a-secure-random-secret-of-at-least-32-bytes
JWT_EXPIRE_HOURS=24

# Initial administrator and analyst accounts
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password
BOOTSTRAP_ANALYST_PASSWORD=replace-with-a-unique-analyst-password

# Authentication
AUTH_REQUIRED=true
